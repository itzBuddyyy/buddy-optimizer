<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Buddy Optimizer - hardware monitor helper.
    Targets .NET Framework 4.7.2 (built into every Windows 10/11), so users
    don't need to install any runtime. Streams one JSON line per tick on stdout.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BuddyMonitor</AssemblyName>
    <RootNamespace>BuddyMonitor</RootNamespace>
    <Product>Buddy Optimizer</Product>
    <Company>itzBuddy</Company>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
